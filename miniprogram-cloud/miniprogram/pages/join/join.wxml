<view class="page">
  <view class="card" wx:if="{{needLogin}}">
    <view class="strong">登录后提交入驻申请</view>
    <view class="muted small mt-s">入驻申请会绑定当前登录账号，审核通过后可用同一账号进入工作台。</view>
    <button class="btn btn-block mt" bindtap="goLogin">去登录</button>
  </view>

  <view class="card" wx:elif="{{!type}}">
    <view class="strong">当前账号暂不支持入驻</view>
    <view class="muted small mt-s">机构请使用「机构」类型账号、大学生请使用「大学生」类型账号登录后提交申请。</view>
  </view>

  <block wx:else>
    <view class="card status">
      <view class="between">
        <text class="strong">{{typeName}}入驻</text>
        <text wx:if="{{status}}" class="tag {{statusTone === 'ok' ? 'tag-ok' : statusTone === 'warn' ? 'tag-warn' : 'tag-muted'}}">{{statusText}}</text>
        <text wx:else class="tag tag-muted">未提交</text>
      </view>
      <view class="muted tiny mt-s" wx:if="{{submittedAt}}">提交时间：{{submittedAt}}</view>
      <view class="row gap mt" wx:if="{{status === 'approved'}}">
        <button wx:if="{{role === 'institution'}}" class="btn btn-sm" bindtap="goWorkspace">进入机构工作台</button>
        <button wx:if="{{role === 'tutor'}}" class="btn btn-sm" bindtap="goCompanion">查看伴学资料</button>
      </view>
    </view>

    <view class="card">
      <view class="field">
        <text class="field-label">{{type === '机构' ? '机构名称' : '姓名'}}</text>
        <input class="input" value="{{form.name}}" data-field="name" bindinput="onField" maxlength="60" placeholder="{{type === '机构' ? '请填写机构全称' : '请填写真实姓名'}}" />
      </view>

      <view class="field" wx:if="{{type === '机构'}}">
        <text class="field-label">联系人</text>
        <input class="input" value="{{form.contact}}" data-field="contact" bindinput="onField" maxlength="100" placeholder="请填写联系人姓名" />
      </view>

      <view class="field" wx:if="{{type === '机构'}}">
        <text class="field-label">服务人群</text>
        <view class="muted tiny">可多选：家长看到的课程页与大学生看到的学习资源页会按这里分区展示。</view>
        <view class="audience-options">
          <view
            wx:for="{{audienceOptions}}"
            wx:key="value"
            class="audience-option {{item.on ? 'on' : ''}}"
            data-value="{{item.value}}"
            bindtap="toggleAudience"
          >
            <view class="audience-box">{{item.on ? '✓' : ''}}</view>
            <view class="audience-text">
              <view class="strong small">{{item.value}}</view>
              <view class="muted tiny">{{item.hint}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">手机号（须与账号手机号一致）</text>
        <input class="input" type="number" value="{{form.phone}}" data-field="phone" bindinput="onField" maxlength="11" placeholder="11 位手机号" />
      </view>

      <block wx:if="{{type === '接送'}}">
        <view class="field">
          <text class="field-label">接送区域（小区 / 片区）</text>
          <input class="input" value="{{form.area}}" data-field="area" bindinput="onField" maxlength="100" placeholder="如 南岗区 · 花园小区" />
        </view>

        <view class="field row gap">
          <view class="grow">
            <text class="field-label">孩子就读学校</text>
            <input class="input" value="{{form.school}}" data-field="school" bindinput="onField" maxlength="100" placeholder="顺路接送的学校" />
          </view>
          <view class="grow">
            <text class="field-label">自家孩子年级</text>
            <input class="input" value="{{form.childGrade}}" data-field="childGrade" bindinput="onField" maxlength="20" placeholder="如 三年级" />
          </view>
        </view>
        <view class="muted tiny" style="margin-top:-8rpx;">私家车入驻仅面向同时接送自家孩子的家长，孩子须在顺路学校就读。</view>

        <view class="field">
          <text class="field-label">车型与安全配置</text>
          <input class="input" value="{{form.vehicle}}" data-field="vehicle" bindinput="onField" maxlength="100" placeholder="如 5 座轿车 · 配儿童安全座椅" />
        </view>

        <view class="field row gap">
          <view class="grow">
            <text class="field-label">可接孩子数（1–6）</text>
            <input class="input" type="number" value="{{form.seat}}" data-field="seat" bindinput="onField" maxlength="1" placeholder="如 2" />
          </view>
          <view class="grow">
            <text class="field-label">接送年数</text>
            <input class="input" type="number" value="{{form.years}}" data-field="years" bindinput="onField" maxlength="2" placeholder="如 3，新手填 0" />
          </view>
        </view>

        <view class="field">
          <text class="field-label">可接时段</text>
          <input class="input" value="{{form.timeText}}" data-field="timeText" bindinput="onField" maxlength="100" placeholder="如 工作日早 07:30 送上 · 晚 16:40 接回" />
        </view>

        <view class="safety-card">
          <view class="strong small">🛡️ 车主安全承诺</view>
          <view class="safety-list">
            <text>· 完成实名核验，无犯罪记录，驾证齐全有效</text>
            <text>· 只接送自家孩子与顺路同校孩子，不载陌生乘客</text>
            <text>· 全程系安全带，学龄前与低龄儿童配安全座椅</text>
            <text>· 只在学校与住址两点往返，不绕路、不中途停留</text>
            <text>· 接送上车第一时间在家长群报位置，异常情况提前告知</text>
          </view>
          <view class="safety-check" bindtap="toggleSafety">
            <view class="safety-box {{safety ? 'on' : ''}}">{{safety ? '✓' : ''}}</view>
            <text class="small">我已阅读并承诺遵守以上安全准则</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{type === '伴学'}}">
        <view class="field row gap">
          <view class="grow">
            <text class="field-label">学历</text>
            <input class="input" value="{{form.education}}" data-field="education" bindinput="onField" maxlength="100" placeholder="如 本科 / 硕士" />
          </view>
          <view class="grow">
            <text class="field-label">年级</text>
            <input class="input" value="{{form.grade}}" data-field="grade" bindinput="onField" maxlength="100" placeholder="如 大二 / 研一" />
          </view>
        </view>

        <view class="field">
          <text class="field-label">就读学校</text>
          <input class="input" value="{{form.school}}" data-field="school" bindinput="onField" maxlength="100" placeholder="请填写学校名称" />
        </view>

        <view class="field">
          <text class="field-label">伴学方向</text>
          <input class="input" value="{{form.subjects}}" data-field="subjects" bindinput="onField" maxlength="100" placeholder="如 阅读陪伴、习惯培养" />
        </view>

        <view class="field row gap">
          <view class="grow">
            <text class="field-label">课时费（元/小时）</text>
            <input class="input" type="digit" value="{{form.hourlyRate}}" data-field="hourlyRate" bindinput="onField" maxlength="8" placeholder="如 120" />
          </view>
          <view class="grow">
            <text class="field-label">性别</text>
            <picker mode="selector" range="{{genders}}" value="{{genderIndex}}" bindchange="onGender">
              <view class="picker">{{form.gender}}</view>
            </picker>
          </view>
        </view>

        <view class="field">
          <text class="field-label">专业（选填）</text>
          <input class="input" value="{{form.major}}" data-field="major" bindinput="onField" maxlength="100" placeholder="如 汉语言文学" />
        </view>

        <view class="field">
          <text class="field-label">简历</text>
          <textarea class="textarea" value="{{form.resume}}" data-field="resume" bindinput="onField" maxlength="1000" placeholder="个人经历、陪伴经验与擅长方向" />
        </view>

        <view class="field">
          <text class="field-label">正脸照片</text>
          <view class="photo-row" bindtap="choosePhoto">
            <image wx:if="{{form.photoPreview}}" class="photo" src="{{form.photoPreview}}" mode="aspectFill" />
            <view wx:else class="photo placeholder">＋ 上传</view>
            <view class="muted tiny">照片仅用于资料展示，建议正面清晰、无水印</view>
          </view>
        </view>

        <view class="banner mt">伴学以阅读陪伴、习惯培养、时间规划等支持为限，不开展学科教学、补课或考试培训。</view>
      </block>

      <button class="btn btn-block mt" bindtap="submit" disabled="{{submitting}}">{{submitting ? '提交中…' : '提交入驻申请'}}</button>
      <view class="muted tiny mt-s">提交后将由平台审核，审核通过后即可发布{{type === '机构' ? '课程' : type === '接送' ? '私家车接送服务' : '伴学服务'}}。</view>
    </view>
  </block>
</view>
