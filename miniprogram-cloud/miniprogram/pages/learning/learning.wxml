<view class="page">
  <view class="head">
    <view class="grow">
      <view class="head-title">学习资源</view>
      <view class="muted small">按考公、考研、考编、职考技能与科目，浏览已入驻机构开设的课程</view>
    </view>
    <image class="head-ip" src="/assets/ip/mascot-side.png" mode="aspectFit" />
  </view>

  <view class="chips mt">
    <view wx:for="{{kinds}}" wx:key="id" class="chip {{kind === item.id ? 'chip-on' : ''}}" data-kind="{{item.id}}" bindtap="onKind">{{item.name}}</view>
  </view>

  <view class="chips mt-s" wx:if="{{subjects.length}}">
    <view class="chip chip-sm {{subject === '全部' ? 'chip-on' : ''}}" data-subject="全部" bindtap="onSubject">全部科目</view>
    <view wx:for="{{subjects}}" wx:key="*this" class="chip chip-sm {{subject === item ? 'chip-on' : ''}}" data-subject="{{item}}" bindtap="onSubject">{{item}}</view>
  </view>

  <view class="kind-tip" wx:if="{{kindTip}}">{{kindTip}}</view>

  <view wx:if="{{loading}}" class="empty">正在加载课程…</view>

  <view wx:elif="{{items.length}}" class="list mt">
    <view wx:for="{{items}}" wx:key="id" class="card course" data-id="{{item.id}}" bindtap="openItem">
      <view class="thumb tone-{{item.tone}}">{{item.icon}}</view>
      <view class="grow">
        <view class="path"><text class="tag">{{item.kindName}}</text><text class="path-sep">›</text><text class="muted small">{{item.subject}}</text></view>
        <view class="course-title">{{item.title}}</view>
        <view class="muted tiny ellipsis">{{item.description}}</view>
        <view class="meta muted tiny">
          <text>🏫 {{item.merchant}}</text>
          <text wx:if="{{item.location}}">⌖ {{item.location}}</text>
          <text>{{item.packages ? item.packages + ' 个套餐' : '默认套餐'}}</text>
        </view>
        <view class="between mt-s">
          <text class="price-small">¥{{item.priceText}}<text class="tiny muted"> / {{item.unit}}</text></text>
          <text class="link small">查看课程 ›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">这个方向暂时还没有上架的课程，换个科目看看</view>

  <view class="section-title">继续准备</view>
  <view class="quick-row">
    <view wx:for="{{quick}}" wx:key="page" class="quick" data-page="{{item.page}}" bindtap="openQuick">
      <view class="quick-icon">{{item.icon}}</view>
      <view class="quick-name">{{item.name}}</view>
      <view class="quick-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
