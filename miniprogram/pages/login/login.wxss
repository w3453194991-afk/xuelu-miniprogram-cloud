.login-page { padding-top: 60rpx; }
.brand { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-bottom: 36rpx; }
.brand-ip { width: 180rpx; height: 180rpx; }
.brand-name { font-size: 40rpx; font-weight: 800; color: #b8500f; }

.roles { display: flex; gap: 16rpx; }
.role {
  flex: 1;
  border: 1rpx solid #f0e3d6;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.role-on { border-color: #e3cdb8; background: #fbe7d6; }
.role-name { font-weight: 700; font-size: 28rpx; }
