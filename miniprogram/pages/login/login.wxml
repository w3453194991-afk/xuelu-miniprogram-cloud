<view class="page login-page">
  <view class="brand">
    <image class="brand-ip" src="/assets/ip/mascot-rest.png" mode="aspectFit" />
    <view class="brand-name">学鹭伴学</view>
    <view class="muted">让每一份成长都有回响</view>
  </view>

  <view class="card">
    <view class="section-title">选择身份</view>
    <view class="roles">
      <view wx:for="{{roles}}" wx:key="id" class="role {{role === item.id ? 'role-on' : ''}}" data-id="{{item.id}}" bindtap="switchRole">
        <text class="role-name">{{item.name}}</text>
        <text class="muted tiny">{{item.desc}}</text>
      </view>
    </view>

    <view class="segs mt">
      <view class="seg {{mode === 'login' ? 'seg-on' : ''}}" bindtap="switchMode">登录</view>
      <view class="seg {{mode === 'register' ? 'seg-on' : ''}}" bindtap="switchMode">注册</view>
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onField" placeholder="请填写 11 位手机号" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" password value="{{password}}" data-field="password" bindinput="onField" placeholder="{{mode === 'register' ? '8–128 位密码' : '请填写密码'}}" />
    </view>

    <button class="btn btn-block mt-l" loading="{{submitting}}" bindtap="submit">{{mode === 'login' ? '登录' : '注册并登录'}}</button>
    <button class="btn btn-plain btn-block mt-s" bindtap="wxLogin">微信一键登录</button>
  </view>
</view>
