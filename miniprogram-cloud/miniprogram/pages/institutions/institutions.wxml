<view class="page">
  <view class="card search">
    <input class="grow" value="{{keyword}}" bindinput="onKeyword" placeholder="搜索机构名称、地址" confirm-type="search" />
    <text class="muted">⌕</text>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载机构…</view>

  <view wx:elif="{{list.length}}" class="list mt">
    <view wx:for="{{list}}" wx:key="id" class="card org" data-name="{{item.name}}" bindtap="openMerchant">
      <view class="between">
        <text class="strong">{{item.name}}</text>
        <view class="org-tags">
          <text class="rating-pill" wx:if="{{item.rating}}">★ {{item.rating.scoreText}}</text>
          <text class="tag">{{item.courseCount}} 门课程</text>
        </view>
      </view>
      <view class="muted small mt-s">{{item.intro || '机构介绍待完善'}}</view>
      <view class="muted tiny mt-s" wx:if="{{item.address}}">⌖ {{item.address}}</view>
      <view class="between mt-s">
        <text class="muted tiny">{{item.contact ? '联系人：' + item.contact : ''}}</text>
        <text class="link small">查看主页 ›</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">没有找到匹配的机构</view>
</view>
