/* 学鹭伴学 · 微信小程序（云开发版）全局样式
 *
 * 主题色：橙色。所有品牌色集中在下面 page 选择器的变量里，
 * 以后换色只改这一段；每一处都写了回退值，低版本基础库也能正常显示。
 */

page {
  --brand: #b8500f;
  --brand-deep: #97400a;
  --brand-light: #d99a52;
  --brand-soft: #fbe7d6;
  --brand-line: #f0e3d6;
  --bg: #fdf8f2;
  --ink: #4a382a;
  --ink-soft: #6b4a2b;
  --muted: #94897e;
  --muted-weak: #b9aca0;
  --line: #f0e3d6;
  --line-strong: #e3cdb8;
  --chip-bg: #fbe7d6;
  --danger: #b4463c;
  --danger-soft: #fdeceb;
  --warn: #98702d;
  --warn-soft: #fff4dc;
  --ok: #8a4a1c;
  --ok-soft: #f7e4d2;

  background: var(--bg, #fdf8f2);
  color: var(--ink, #4a382a);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 24rpx 180rpx;
}

/* ---------- 布局 ---------- */
.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.gap { gap: 16rpx; }
.gap-s { gap: 10rpx; }
.mt { margin-top: 20rpx; }
.mt-s { margin-top: 12rpx; }
.mt-l { margin-top: 32rpx; }
.center { justify-content: center; }

/* ---------- 文字 ---------- */
.muted { color: var(--muted, #94897e); }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 700; }
.title { font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 32rpx 0 16rpx; }
.price { color: var(--brand, #b8500f); font-weight: 800; font-size: 36rpx; }
.price-small { color: var(--brand, #b8500f); font-weight: 700; }
.link { color: var(--brand-deep, #97400a); }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pre { white-space: pre-wrap; word-break: break-all; }

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 76, 40, 0.06);
}
.card + .card { margin-top: 20rpx; }

/* ---------- 色调（对应服务 tone 字段，作为内容插画底色保留） ---------- */
.tone-peach { background: linear-gradient(135deg, #ffe9d6, #ffd9bd); }
.tone-lavender { background: linear-gradient(135deg, #f7ece7, #efdccb); }
.tone-mint { background: linear-gradient(135deg, #f7e6d2, #eed3b8); }
.thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  line-height: 1.4;
  border: none;
  background: var(--brand, #b8500f);
  color: #ffffff;
  font-weight: 600;
}
.btn::after { border: none; }
.btn-plain { background: var(--brand-soft, #fbe7d6); color: var(--brand-deep, #97400a); }
.btn-ghost { background: #ffffff; color: var(--ink-soft, #6b4a2b); border: 1rpx solid var(--line-strong, #e3cdb8); }
.btn-danger { background: var(--danger-soft, #fdeceb); color: var(--danger, #b4463c); }
.btn[disabled] { opacity: 0.55; color: #ffffff; }
.btn-plain[disabled], .btn-ghost[disabled], .btn-danger[disabled] { color: var(--muted, #94897e); }
/* 小程序 button 默认 width:100%，放在 flex 行里会把输入框挤扁 */
.btn-sm { padding: 10rpx 24rpx; font-size: 24rpx; width: auto; flex: none; }
/* 搜索框右侧的搜索按钮：只做一个小胶囊，尽量把宽度让给输入框
 * 注意：小程序 button 默认宽度 184px，必须显式写死宽高才能真的变小 */
.search-btn {
  flex: none;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin: 0;
  padding: 0;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
}
.btn-block { display: block; width: 100%; text-align: center; }

/* ---------- 服务人群多选（入驻 / 机构工作台共用） ---------- */
.audience-options { display: flex; flex-direction: column; gap: 16rpx; margin-top: 12rpx; }
.audience-option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid var(--line-strong, #e3cdb8);
  box-sizing: border-box;
}
.audience-option.on {
  border-color: var(--brand, #b8500f);
  background: var(--brand-soft, #fbe7d6);
}
.audience-box {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line-strong, #e3cdb8);
  background: #ffffff;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
.audience-option.on .audience-box {
  background: var(--brand, #b8500f);
  border-color: var(--brand, #b8500f);
  color: #ffffff;
}
.audience-text { flex: 1; min-width: 0; }

/* ---------- 学鹭助手悬浮入口 ---------- */
.float-assistant {
  position: fixed;
  right: 28rpx;
  bottom: 208rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(120, 76, 40, 0.18);
}
.float-assistant image {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 2rpx;
  border-radius: 50%;
  background: var(--brand-soft, #fbe7d6);
}
.float-assistant text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-deep, #97400a);
}

/* ---------- 表单 ---------- */
.field { margin-top: 24rpx; }
.field-label { font-size: 26rpx; color: var(--ink-soft, #6b4a2b); margin-bottom: 10rpx; display: block; }
.input, .textarea, .picker {
  background: #ffffff;
  border: 1rpx solid var(--line-strong, #e3cdb8);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  color: var(--ink, #4a382a);
}
.textarea { min-height: 160rpx; }
.picker { color: var(--ink, #4a382a); }
/* input 是原生组件，不设高度时文字会被裁切 */
.input { height: 92rpx; line-height: 52rpx; padding: 0 24rpx; }

/* ---------- 标签 / 筛选 chips ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--chip-bg, #fbe7d6);
  color: var(--ink-soft, #6b4a2b);
  font-size: 24rpx;
  border: 1rpx solid transparent;
}
.chip-on {
  background: var(--brand-soft, #fbe7d6);
  color: var(--brand-deep, #97400a);
  border-color: var(--brand-line, #e3cdb8);
  font-weight: 600;
}
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: var(--brand-soft, #fbe7d6);
  color: var(--brand-deep, #97400a);
}
.tag-muted { background: #f4efe9; color: var(--muted, #94897e); }
.tag-ok { background: var(--ok-soft, #f7e4d2); color: var(--ok, #8a4a1c); }
.tag-warn { background: var(--warn-soft, #fff4dc); color: var(--warn, #98702d); }
/* 志愿填报的冲 / 稳 / 保三档 */
.tag-chong { background: #f8efe1; color: #a8763a; }
.tag-wen { background: #fbe7d6; color: #b8500f; }
.tag-bao { background: #efe6dc; color: #6b4a2b; }
.tag-danger { background: var(--danger-soft, #fdeceb); color: var(--danger, #b4463c); }

/* ---------- 星级（伴学老师评价） ---------- */
.stars { display: flex; align-items: center; gap: 2rpx; }
.star { font-size: 22rpx; line-height: 1; color: #e2d3c4; }
.star.on { color: #e8912f; }
.score-text { font-size: 22rpx; font-weight: 700; color: var(--brand, #b8500f); margin-left: 8rpx; }
.count-text { font-size: 20rpx; color: var(--muted, #94897e); margin-left: 8rpx; }

/* ---------- 分段 ---------- */
.segs { display: flex; background: #f4efe9; border-radius: 999rpx; padding: 6rpx; }
.seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-soft, #6b4a2b);
}
.seg-on { background: #ffffff; color: var(--brand-deep, #97400a); font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(120, 76, 40, 0.08); }

/* ---------- 空态 / 提示 ---------- */
.empty {
  text-align: center;
  color: var(--muted, #94897e);
  padding: 80rpx 0;
  font-size: 26rpx;
}
.banner {
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  background: var(--warn-soft, #fff4dc);
  color: var(--warn, #98702d);
}
.banner-ok { background: var(--ok-soft, #f7e4d2); color: var(--ok, #8a4a1c); }
.banner-brand { background: var(--brand-soft, #fbe7d6); color: var(--brand-deep, #97400a); }
.banner-danger { background: var(--danger-soft, #fdeceb); color: var(--danger, #b4463c); }

/* ---------- 列表行 ---------- */
.line-row { padding: 18rpx 0; border-bottom: 1rpx solid var(--line, #f0e3d6); }
.line-row:last-child { border-bottom: none; }

/* ---------- 底部操作条 ---------- */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line, #f0e3d6);
  display: flex;
  gap: 16rpx;
  align-items: center;
  z-index: 10;
}

/* ---------- 表格（工作台 / 审批） ---------- */
.grid-table { width: 100%; font-size: 24rpx; }
.grid-row { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid var(--line, #f0e3d6); align-items: center; }
.grid-row:last-child { border-bottom: none; }
.grid-cell { flex: 1; min-width: 0; padding-right: 12rpx; }
.grid-cell:last-child { padding-right: 0; }
